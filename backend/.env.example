# AcademicOS backend — environment template
# Copy to `.env` and adjust. Never commit the real `.env`.

APP_NAME=AcademicOS
ENVIRONMENT=development
API_V1_PREFIX=/api/v1
VERSION=0.1.0

# PostgreSQL
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/academicos

# Qdrant
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# JWT
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_SECONDS=3600
REFRESH_TOKEN_TTL_SECONDS=604800

# CORS (comma-separated origins served by the Next.js frontend)
CORS_ORIGINS=http://localhost:3000
