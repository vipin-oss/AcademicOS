# AcademicOS backend — environment template
# Copy to `.env` and adjust. Never commit the real `.env`.

APP_NAME=AcademicOS
ENVIRONMENT=development
API_V1_PREFIX=/api/v1
VERSION=0.1.0

# PostgreSQL
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/academicos

# Qdrant
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# File storage (local adapter root) + public URL used for download links
STORAGE_DIR=./storage
PUBLIC_BASE_URL=http://localhost:8000

# JWT
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_SECONDS=3600
REFRESH_TOKEN_TTL_SECONDS=604800

# CORS (origins served by the Next.js frontend; JSON array form — the
# pydantic-settings dotenv source decodes complex fields as JSON)
CORS_ORIGINS=["http://localhost:3000"]
