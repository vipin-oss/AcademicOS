# AcademicOS backend — environment template
# Copy to `.env` and adjust. Never commit the real `.env`.
#
# QUICKSTART (SQLite — zero infrastructure, recommended for Windows):
#   DATABASE_URL=sqlite:///./academicos.db
#   then run:  python scripts/init_db.py
#
# FULL STACK (PostgreSQL + Qdrant + Ollama — docker compose up -d db qdrant ollama):
#   DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/academicos
#   QDRANT_URL=http://localhost:6333
#   then run:  alembic upgrade head
#   First time only: docker exec academicos-ollama ollama pull llama3.2

APP_NAME=AcademicOS
ENVIRONMENT=development
API_V1_PREFIX=/api/v1
VERSION=0.1.0

# PostgreSQL (required for the full stack; SQLite for the quickstart)
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/academicos

# Qdrant vector store (optional — search degrades to lexical-only when unreachable)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# File storage (local adapter root) + public URL used for download links
STORAGE_DIR=./storage
PUBLIC_BASE_URL=http://localhost:8000

# JWT
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_SECONDS=3600
REFRESH_TOKEN_TTL_SECONDS=604800
PASSWORD_RESET_TOKEN_TTL_SECONDS=1800

# First-admin bootstrap
BOOTSTRAP_ADMIN_USERNAME=admin

# CORS
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://[::1]:3000"]

# Assistant
ASSISTANT_MODELS_JSON=
ASSISTANT_DEFAULT_MODEL=default
ASSISTANT_LLM_BASE_URL=
ASSISTANT_LLM_MODEL=academicos-default
ASSISTANT_LLM_API_KEY=
ASSISTANT_LLM_TIMEOUT_SECONDS=30
ASSISTANT_REVIEW_ENABLED=false

# ---- AI Core (Sprint M11+) — LOCAL/FREE AI via Ollama -----------------
# Master switch: when false, ALL AI endpoints return 404.
AI_ENABLED=true
# Per-capability flags:
AI_CHAT_ENABLED=true
AI_QA_ENABLED=true
AI_SUMMARIZATION_ENABLED=true
AI_ENRICHMENT_ENABLED=true
AI_RELATED_DOCUMENTS_ENABLED=true
AI_SEMANTIC_SEARCH_ENABLED=true
AI_STREAMING_ENABLED=true

# Provider: points to the local Ollama container (OpenAI-compatible API).
# Works with NO API KEY (api_key=""). The model must be pulled first:
#   docker exec academicos-ollama ollama pull llama3.2
AI_PROVIDERS_JSON=[{"provider_id":"local-ollama","kind":"openai","model":"llama3.2","base_url":"http://localhost:11434/v1","api_key":"","temperature":0.0,"max_tokens":2048,"streaming_enabled":true,"timeout_seconds":120}]
AI_DEFAULT_PROVIDER=local-ollama
AI_DEFAULT_MODEL=

# Generation defaults.
AI_TEMPERATURE=0.0
AI_MAX_TOKENS=2048
AI_TIMEOUT_SECONDS=30.0
