# AcademicOS backend — environment template
# Copy to `.env` and adjust. Never commit the real `.env`.
#
# QUICKSTART (SQLite — zero infrastructure, recommended for Windows):
#   DATABASE_URL=sqlite:///./academicos.db
#   then run:  python scripts/init_db.py
#
# FULL STACK (PostgreSQL + Qdrant — docker-compose up -d db qdrant):
#   DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/academicos
#   QDRANT_URL=http://localhost:6333
#   then run:  alembic upgrade head

APP_NAME=AcademicOS
ENVIRONMENT=development
API_V1_PREFIX=/api/v1
VERSION=0.1.0

# PostgreSQL (required for the full stack; SQLite for the quickstart)
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/academicos

# Qdrant vector store (optional — search degrades to lexical-only when unreachable)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# File storage (local adapter root) + public URL used for download links
STORAGE_DIR=./storage
PUBLIC_BASE_URL=http://localhost:8000

# JWT
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_SECONDS=3600
REFRESH_TOKEN_TTL_SECONDS=604800
PASSWORD_RESET_TOKEN_TTL_SECONDS=1800

# First-admin bootstrap: the username promoted to ADMIN on first boot when
# it has no roles yet (idempotent). Register the user first, then restart
# with this set, or set it before the first run of an existing account.
BOOTSTRAP_ADMIN_USERNAME=admin

# CORS (origins served by the Next.js frontend; JSON array form — the
# pydantic-settings dotenv source decodes complex fields as JSON).
# All three canonical local dev origins: browsers may open the app at
# `localhost`, `127.0.0.1`, or (Windows IPv6-first resolution) `[::1]`.
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://[::1]:3000"]

# Assistant — model registry (JSON list) and defaults. Each entry:
#   {"id": "...", "base_url": "...", "model": "...", "api_key": "...", "timeout_seconds": 30}
# Empty/absent -> the legacy single-model settings below synthesize the
# default model; the deterministic rules provider is always registered.
ASSISTANT_MODELS_JSON=
ASSISTANT_DEFAULT_MODEL=default

# Legacy single-model LLM settings (used only when ASSISTANT_MODELS_JSON is empty)
ASSISTANT_LLM_BASE_URL=
ASSISTANT_LLM_MODEL=academicos-default
ASSISTANT_LLM_API_KEY=
ASSISTANT_LLM_TIMEOUT_SECONDS=30

# Human review gate: when true, every fresh assistant answer is stored
# PENDING and only becomes visible after approval (review workspace).
ASSISTANT_REVIEW_ENABLED=false

# ---- AI Core (Sprint M11+) ----------------------------------------------
# Master switch: when false, ALL AI endpoints return 404.
AI_ENABLED=true
# Per-capability flags (all default false — enable the ones you want):
AI_CHAT_ENABLED=true
AI_QA_ENABLED=false
AI_SUMMARIZATION_ENABLED=false
AI_ENRICHMENT_ENABLED=false
AI_RELATED_DOCUMENTS_ENABLED=false
AI_SEMANTIC_SEARCH_ENABLED=false
AI_STREAMING_ENABLED=true

# Default provider (a provider_id from AI_PROVIDERS_JSON, or a kind).
AI_DEFAULT_PROVIDER=local
AI_DEFAULT_MODEL=

# Generation defaults.
AI_TEMPERATURE=0.0
AI_MAX_TOKENS=2048
AI_TIMEOUT_SECONDS=30.0

# Provider configuration: JSON list of entries, e.g.:
#   [{"provider_id":"local-ollama","kind":"openai","model":"llama3.1",
#     "base_url":"http://localhost:11434/v1","api_key":"",
#     "streaming_enabled":true}]
# Empty/absent -> no AI provider is wired (all AI endpoints return
# available=false with an honest fallback). Local/free models (Ollama, vLLM,
# LM Studio) work through the OpenAI-compatible boundary with api_key="".
AI_PROVIDERS_JSON=
