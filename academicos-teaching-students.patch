+];
+
+export const CLASS_LINK_GROUPS: { value: ClassLinkGroup; label: string }[] = [
+  { value: "teachers", label: "Teachers" },
+  { value: "departments", label: "Departments" },
+];
+
+export const WEEKDAYS: { value: string; label: string }[] = [
+  { value: "mon", label: "Mon" },
+  { value: "tue", label: "Tue" },
+  { value: "wed", label: "Wed" },
+  { value: "thu", label: "Thu" },
+  { value: "fri", label: "Fri" },
+  { value: "sat", label: "Sat" },
+  { value: "sun", label: "Sun" },
+];
