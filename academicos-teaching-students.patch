+/** Every student type the UI knows how to label (PART A taxonomy). */
+export const STUDENT_TYPES: { value: StudentTypeValue; label: string }[] = [
+  { value: "ug", label: "UG" },
+  { value: "pg", label: "PG" },
+  { value: "phd", label: "PhD" },
+  { value: "alumni", label: "Alumni" },
+];
