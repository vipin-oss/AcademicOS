# AcademicOS frontend — environment template
# Copy to `.env.local` and adjust.

# The backend API root. The default (when unset) is http://127.0.0.1:8000/api/v1
# — the IPv4 literal, NOT `localhost`, because on Windows `localhost` can
# resolve to ::1 while uvicorn listens on 127.0.0.1 only.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000/api/v1
